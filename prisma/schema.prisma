generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  cliente
  vendedor
  admin
  superAdmin
}

enum AccountType {
  minorista
  mayorista
}

enum ApprovalStatus {
  approved
  pending
  rejected
}

enum OrderStatus {
  pendiente
  en_revision    @map("en revision")
  aprobado
  rechazado
  en_preparacion @map("en preparacion")
  listo
  reservado
  enviado
  entregado
  cancelado
}

enum ContactStatus {
  nuevo
  leido
  respondido
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  password            String
  role                UserRole       @default(cliente)
  accountType         AccountType    @default(minorista)
  approved            Boolean        @default(false)
  approvalStatus      ApprovalStatus @default(approved)
  assignedSellerId    String?
  assignedSeller      User?          @relation("SellerClients", fields: [assignedSellerId], references: [id])
  assignedClients     User[]         @relation("SellerClients")
  mustChangePassword  Boolean        @default(false)
  /// Las sesiones abiertas antes de esta fecha dejan de valer (cambio de clave, cuenta eliminada).
  sessionsValidFrom   DateTime?
  active              Boolean        @default(true)
  phone               String         @default("")
  cuit                String         @default("")
  businessName        String         @default("")
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  orders              Order[]        @relation("CustomerOrders")
  sellerOrders        Order[]        @relation("SellerOrders")
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  savedCart           SavedCart?

  @@index([accountType, approvalStatus])
  @@index([role, active])
}

model Product {
  id             String      @id @default(cuid())
  name           String
  sku            String      @unique
  description    String      @default("")
  sizeGuide      String      @default("")
  category       String
  categories     String[]
  subcategory    String      @default("")
  brand          String      @default("")
  priceRetail    Float
  priceWholesale Float
  tax            Float       @default(0)
  stock          Int         @default(0)
  images         String[]
  colors         String[]    @default([])
  sizes          String[]    @default([])
  variants       Json        @default("[]")
  tags           String[]
  featured       Boolean     @default(false)
  discount       Float       @default(0)
  newArrival     Boolean     @default(false)
  active         Boolean     @default(true)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([category, active])
  @@index([brand, active])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  slug           String
  description    String   @default("")
  active         Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique @default(cuid())
  userId       String?
  user         User?       @relation("CustomerOrders", fields: [userId], references: [id])
  customerName String      @default("")
  customerEmail String     @default("")
  sellerId     String?
  seller       User?       @relation("SellerOrders", fields: [sellerId], references: [id])
  emailNotifications OrderApprovalEmail[]
  checkoutRequest CheckoutRequest?
  items        OrderItem[]
  total        Float
  couponCode   String      @default("")
  discountAmount Float     @default(0)
  shippingCost Float       @default(0)
  taxAmount    Float       @default(0)
  paymentMethod String
  status       OrderStatus @default(pendiente)
  shipping     Json?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([sellerId, status])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  percent     Float
  minSubtotal Float    @default(0)
  maxUses     Int
  usedCount   Int      @default(0)
  expiresAt   DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  image       String  @default("")
  productName String
  variantSku  String  @default("")
  selectedColor String @default("")
    selectedSize String @default("")
    selectedGender String @default("")
  quantity   Int
  unitPrice  Float
  subtotal   Float
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model Settings {
  id                String   @id @default(cuid())
  minWholesaleOrder Float    @default(0)
  taxPercentage     Float    @default(0)
  vatRateCached     Float?
  vatRateCheckedAt  DateTime?
  vatRateAttemptedAt DateTime?
  paymentMethods    String[]
  whatsappNumber    String   @default("")
  automaticMessages Json?
  navigationBrands  Json?
  navigationDisciplines Json?
  heroProductIds    String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String        @default("")
  subject   String
  message   String
  status    ContactStatus @default(nuevo)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderApprovalEmail {
  id String @id @default(cuid())
  orderId String
  kind String @default("approval")
  order Order @relation(fields: [orderId], references: [id])
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@unique([orderId, kind])
  @@index([status, nextAttemptAt])
}

model CheckoutRequest {
  keyHash String @id
  ownerHash String
  fingerprint String
  orderId String? @unique
  order Order? @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Noticias o avisos que la tienda muestra en una ventana al entrar. Solo una está activa a la vez.
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String   @default("")
  imageData   String   @default("")
  buttonLabel String   @default("")
  buttonUrl   String   @default("")
  theme       String   @default("oscuro")
  layout      String   @default("arriba")
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, updatedAt])
}

/// Carrito de un cliente con sesión iniciada, para ver en el panel quién dejó productos sin comprar.
model SavedCart {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json
  itemCount Int      @default(0)
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// Conexión con Xubio (sistema de facturación) para traer el stock. Hay una sola fila ("main").
/// Las claves se guardan cifradas y nunca se devuelven al panel.
model XubioConnection {
  id          String    @id @default("main")
  clientIdEnc String
  secretEnc   String
  clientHint  String    @default("")
  autoSync    Boolean   @default(false)
  lastSyncAt  DateTime?
  lastResult  Json?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
